# ---------------------------------------------------------------------------
# DEVFORGE — Variables d'environnement
# Copiez ce fichier en `.env.local` puis renseignez vos propres valeurs.
# Ne committez jamais `.env.local`.
# ---------------------------------------------------------------------------

# Supabase — tableau de bord > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Service Role key.
# UNIQUEMENT si vous exécutez les scripts d'administration (seed manuel).
# Cette clé ne doit JAMAIS être utilisée dans le navigateur ni dans du code
# exécuté côté client. L'application n'en a pas besoin pour fonctionner.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (utilisée pour les redirections d'e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
